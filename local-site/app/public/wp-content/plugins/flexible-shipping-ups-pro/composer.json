{
	"name": "octolize-plugin/flexible-shipping-ups-pro",
	"authors": [
		{
			"name": "Krzysiek",
			"email": "krzysiek@wpdesk.pl"
		},
		{
			"name": "Grzegorz",
			"email": "grzegorz@octolize.com"
		}
	],
	"description": "WooCommerce UPS integration packed with many advanced features. Display the dynamically calculated live rates for UPS shipping methods and adjust them to your needs.",
	"type": "wordpress-plugin",
	"keywords": ["woocommerce", "ups", "live rates", "octolize", "plugin", "shipping"],
	"homepage": "https://octolize.com/product/ups-woocommerce-live-rates-and-access-points-pro/",
	"config": {
		"autoloader-suffix": "FsUpsPro",
		"sort-packages": true,
		"platform": {
			"php": "7.4"
		},
		"gitlab-domains": ["gitlab.wpdesk.dev"],
		"allow-plugins": {
			"cweagans/composer-patches": true,
			"kylekatarnls/update-helper": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"wpdesk/wp-codeception": true,
			"wpdesk/wp-wpdesk-composer": true
		}
	},
	"prefer-stable": true,
	"minimum-stability": "stable",
	"require": {
		"php": ">=7.4",
		"wpdesk/wp-wpdesk-helper-override": "^1.1.0"
	},
	"require-dev": {
		"10up/wp_mock": "*",
		"dvdoug/boxpacker": "^3.9",
		"mockery/mockery": "*",
		"octolize/wp-csat-petition": "^1.0.0",
		"octolize/octolize-pickup-point-checkout-blocks": "^2.5.1",
		"octolize/wp-octolize-tracker": "^1.2",
		"octolize/wp-onboarding": "^1.9",
		"octolize/wp-plugin-update-reminder": "^1.0",
		"octolize/wp-shipping-extensions": "^1.2.0",
		"octolize/wp-ups-oauth": "^1.5.1",
		"phpunit/phpunit": "^7||^8||^9",
		"wpdesk/ups-pro-shipping-service": "^2",
		"wpdesk/ups-shipping-service": "^3.4.0",
		"wpdesk/wc-currency-switchers-integrations": "^1",
		"wpdesk/wp-codeception": "^2.12.2",
		"wpdesk/wp-persistence": "^3.0",
		"wpdesk/wp-plugin-flow": "^3.1",
		"wpdesk/wp-pro-woocommerce-shipping": "^2.0.0",
		"wpdesk/wp-settings-field-boxes": "^2.0.5",
		"wpdesk/wp-ups-shipping-method": "^3.2",
		"wpdesk/wp-woocommerce-shipping": "^3.36.0",
		"wpdesk/wp-wpdesk-composer": "^3.1.1"
	},
	"autoload": {
		"psr-4": {
			"WPDesk\\FlexibleShippingUpsPro\\": "src/FlexibleShippingUpsPro"
		},
		"classmap": [
			"vendor_prefixed"
		]
	},
	"autoload-dev": {
		"classmap": [
			"tests/"
		],
		"exclude-from-classmap": [
			"test/*/mock/*"
		]
	},
	"extra": {
		"text-domain": "flexible-shipping-ups-pro",
		"translations-folder": "lang",
		"translation-file-headers": {
			"Project-Id-Version": "Flexible Shipping UPS PRO",
			"Last-Translator": "Grzegorz Rola <grola@wpdesk.pl>",
			"X-Poedit-WPHeader": "flexible-shipping-ups-pro.php"
		},
		"po-files": {
			"pl_PL": "pl_PL.po"
		},
		"minify-assets": {
			"css": [
				"assets/css/admin.css"
			]
		},
		"php-requires": "7.4",
		"prefix_psr": true
	},
	"scripts": {
		"test": "echo composer is alive",
		"phpcs": "phpcs",
		"phpunit-unit": "phpunit --configuration phpunit-unit.xml --coverage-text --colors=never",
		"phpunit-unit-fast": "phpunit --configuration phpunit-unit.xml --no-coverage",
		"phpunit-integration": "phpunit --configuration phpunit-integration.xml --coverage-text --colors=never",
		"phpunit-integration-fast": "phpunit --configuration phpunit-integration.xml --no-coverage",
		"docs": "apigen generate",
		"copy-templates": [
			"php -r \"if ( ! file_exists('templates') ) { mkdir('templates'); }\"",
			"php -r \"copy('./vendor_prefixed/wpdesk/wp-woocommerce-shipping/templates/after-shipping-rate-days-to-arrival.php', 'templates/after-shipping-rate-days-to-arrival.php');\"",
			"php -r \"copy('./vendor_prefixed/wpdesk/wp-woocommerce-shipping/templates/after-shipping-rate-delivery-date.php', 'templates/after-shipping-rate-delivery-date.php');\"",
			"php -r \"copy('./vendor_prefixed/wpdesk/wp-woocommerce-shipping/templates/shipping-method-after-access-point-select.php', 'templates/shipping-method-after-access-point-select.php');\"",
			"php -r \"copy('./vendor_prefixed/wpdesk/wp-woocommerce-shipping/templates/shipping-method-after-access-point-single.php', 'templates/shipping-method-after-access-point-single.php');\""
		],
		"post-update-cmd": "@copy-templates",
		"post-install-cmd": "@copy-templates"
	},
	"repositories": {
		"octolize": {
			"type": "composer",
			"url": "https://gitlab.wpdesk.dev/api/v4/group/wpdesk/-/packages/composer/"
		},
		"wpdesk": {
			"type": "composer",
			"url": "https://gitlab.wpdesk.dev/api/v4/group/wpdesk/-/packages/composer/"
		}
	},
	"version": "3.7.1"
}
